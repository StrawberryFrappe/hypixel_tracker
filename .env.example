# Development-only placeholders. Copy to .env, then replace every CHANGEME value.
# Compose refuses to render when required variables are absent.

BAZAAR_GURU_BIND_ADDRESS=127.0.0.1
BAZAAR_GURU_HOSTNAME=localhost

RAW_DB_NAME=bazaar_raw
RAW_BOOTSTRAP_USER=raw_bootstrap
RAW_BOOTSTRAP_PASSWORD=CHANGEME_RAW_BOOTSTRAP_PASSWORD
RAW_MIGRATOR_USER=raw_migrator
RAW_MIGRATOR_PASSWORD=CHANGEME_RAW_MIGRATOR_PASSWORD
RAW_RUNTIME_USER=raw_runtime
RAW_RUNTIME_PASSWORD=CHANGEME_RAW_RUNTIME_PASSWORD

APP_DB_NAME=bazaar_app
APP_BOOTSTRAP_USER=app_bootstrap
APP_BOOTSTRAP_PASSWORD=CHANGEME_APP_BOOTSTRAP_PASSWORD
APP_MIGRATOR_USER=app_migrator
APP_MIGRATOR_PASSWORD=CHANGEME_APP_MIGRATOR_PASSWORD
APP_RUNTIME_USER=app_runtime
APP_RUNTIME_PASSWORD=CHANGEME_APP_RUNTIME_PASSWORD

# Keep passwords URL-safe or percent-encode them in DSNs.
BAZAAR_GURU_RAW_MIGRATION_DATABASE_URL=postgresql+psycopg://raw_migrator:CHANGEME_RAW_MIGRATOR_PASSWORD@raw-db:5432/bazaar_raw
BAZAAR_GURU_APP_MIGRATION_DATABASE_URL=postgresql+psycopg://app_migrator:CHANGEME_APP_MIGRATOR_PASSWORD@app-db:5432/bazaar_app
BAZAAR_GURU_RAW_RUNTIME_ROLE=raw_runtime
BAZAAR_GURU_APP_RUNTIME_ROLE=app_runtime
BAZAAR_GURU_RAW_DATABASE_URL=postgresql+psycopg://raw_runtime:CHANGEME_RAW_RUNTIME_PASSWORD@raw-db:5432/bazaar_raw
BAZAAR_GURU_APP_DATABASE_URL=postgresql+psycopg://app_runtime:CHANGEME_APP_RUNTIME_PASSWORD@app-db:5432/bazaar_app
